<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\Endjin.Conventions.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <RootNamespace> </RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shipped as a dotnet tool: `dotnet tool install -g Ais.Net.Broadcaster.Cli`, then `ais-broadcaster`. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ais-broadcaster</ToolCommandName>
    <PackageId>Ais.Net.Broadcaster.Cli</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageDescription>Command-line NMEA AIS broadcaster: replays a recording or relays a live feed to TCP and WebSocket clients, with pacing and fault injection. Sponsored by endjin.</PackageDescription>
    <PackageTags>ais;aisvdm;aivdo;nmea;marine;gis;simulator;websocket;tcp;dotnet-tool;endjin</PackageTags>
    <PackageReleaseNotes></PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="$(ContinuousIntegrationBuild) == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ais.Net.Broadcaster\Ais.Net.Broadcaster.csproj" />
    <ProjectReference Include="..\Ais.Net.Receiver\Ais.Net.Receiver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Spectre.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- A short NLOD-licensed recording so `ais-broadcaster replay` works out of the box. -->
    <None Include="samples\**" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="samples" />
  </ItemGroup>

</Project>
