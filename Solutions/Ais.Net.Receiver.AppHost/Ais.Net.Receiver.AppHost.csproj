<Project Sdk="Aspire.AppHost.Sdk/13.6.4">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <!-- Orchestration dependencies (DCP, dashboard) come from NuGet; the Aspire CLI bundle is not required. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>dotnet-Ais.Net.Receiver.AppHost-8e1f4c27-3a96-4d0b-b5e2-1c7a9f6d2e48</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.Nats" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ais.Net.Broadcaster.Host.Console\Ais.Net.Broadcaster.Host.Console.csproj" />
    <ProjectReference Include="..\Ais.Net.Receiver.Host.Console\Ais.Net.Receiver.Host.Console.csproj" />
    <ProjectReference Include="..\Ais.Net.Receiver.Host.Worker\Ais.Net.Receiver.Host.Worker.csproj" />
    <ProjectReference Include="..\Ais.Net.Receiver.Demo.Visualizer\Ais.Net.Receiver.Demo.Visualizer.csproj" />
  </ItemGroup>
</Project>
