<Project>

  <!--
    Conventions that used to arrive via the Endjin.RecommendedPractices.GitHub NuGet package (and its
    Endjin.RecommendedPractices dependency).

    That package was removed because it injects StyleCop.Analyzers and Roslynator.Analyzers as
    PackageReference items carrying hardcoded Version attributes, which Central Package Management
    rejects with NU1008 - so it cannot be used by a CPM solution without disabling the analyzers that
    are its main reason for existing.

    This is imported explicitly near the top of each project that previously referenced the package,
    which reproduces two things about how it worked:

      - It is opt-in per project. A Directory.Build.props would apply to every project in the
        solution, silently turning on warnings-as-errors and XML documentation for the AppHost,
        Benchmarks, ServiceDefaults and test projects, which never had them.
      - It is imported after the .NET SDK's own props, which matters for RootNamespace: the SDK
        defaults it to the project name, so clearing it from a Directory.Build.props (imported before
        the SDK) would have no effect. The package used the same trick, via $(EndjinProjectPropsPath).

    The files the package would also have supplied and that are still needed - .editorconfig and
    PackageIcon.png - are checked in alongside this file. Its stylecop.json went with the package: no
    analyzer reads it now, and the StyleCop suppressions that accompanied it (in .editorconfig and in
    each project's NoWarn) referred to rules nothing raises any more.
  -->

  <PropertyGroup>
    <Authors>Endjin Limited</Authors>

    <!--
      The year is computed at build time (UTC) so the notice never goes stale. Only the Copyright
      assembly attribute and package metadata vary with it, so builds remain functionally identical
      across a year boundary. The year is taken from SOURCE_DATE_EPOCH (the reproducible-builds
      convention, Unix seconds) when it is set, which the ZeroFailed build (.zf/*.ps1) pins to the
      HEAD commit's timestamp, so a commit rebuilds byte for byte in any year; an ad-hoc dotnet build
      without it falls back to the clock.
    -->
    <CopyrightYear Condition="'$(SOURCE_DATE_EPOCH)' != ''">$([System.DateTime]::UnixEpoch.AddSeconds($(SOURCE_DATE_EPOCH)).Year)</CopyrightYear>
    <CopyrightYear Condition="'$(CopyrightYear)' == ''">$([System.DateTime]::UtcNow.Year)</CopyrightYear>
    <Copyright>Copyright (c) Endjin Limited $(CopyrightYear). All rights reserved.</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Packaging conventions. The license is declared per project; see Ais.Net.Receiver.csproj. -->
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/ais-dotnet/Ais.Net.Receiver</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>

    <!--
      Source Link. RepositoryUrl is filled in from the git remote by the SDK, which has bundled Source
      Link since .NET 8 - so unlike when the Endjin package supplied it, no Microsoft.SourceLink.GitHub
      reference is needed.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Package icon. The removed package set this and packed the solution-level PackageIcon.png
      itself; without it the nupkg ships with no icon. The file lives alongside this props file.
    -->
    <PackageIcon>PackageIcon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)PackageIcon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    CI detection (ContinuousIntegrationBuild from TF_BUILD / GITHUB_ACTIONS) lives in
    Directory.Build.props rather than here: this file is opt-in per project, and the projects that
    restore in locked mode depend on that property too, so it must reach every project.
  -->

  <PropertyGroup>
    <!--
      Warnings are errors in every configuration, not only Release. Projects also set this for Release
      themselves, which is now redundant but harmless. Suppressions live in each project's NoWarn.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TreatSpecificWarningsAsErrors />
    <WarningsAsErrors />

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Analysis, replacing what the removed package's StyleCop and Roslynator references provided.

      EnableNETAnalyzers is already the default for net5.0 and later; it is stated explicitly so the
      intent survives a future retarget. EnforceCodeStyleInBuild is not a default - it promotes the
      IDE* code-style rules from IDE-only suggestions to build diagnostics, governed by the severities
      in Solutions/.editorconfig.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      endjin's folder layout spells the full namespace out in the directory structure, so there is no
      single shared root namespace to derive from the project name; every file declares its namespace
      explicitly.
    -->
    <RootNamespace />
  </PropertyGroup>

</Project>
