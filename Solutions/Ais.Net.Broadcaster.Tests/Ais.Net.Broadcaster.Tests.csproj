<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <TestingExtensionsProfile>Default</TestingExtensionsProfile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Spectre.IO.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ais.Net.Broadcaster\Ais.Net.Broadcaster.csproj" />
    <ProjectReference Include="..\Ais.Net.Receiver\Ais.Net.Receiver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI's sample recording, so a test can check it without depending on the working directory. -->
    <None Include="..\Ais.Net.Broadcaster.Host.Console\samples\sample.nm4" Link="samples\sample.nm4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Ais.Net.Broadcaster.Host.Console\samples\kystverket-20260511T00.nm4" Link="samples\kystverket-20260511T00.nm4" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Ais.Net.Broadcaster.Host.Console\samples\kystverket-20260511T00.nm4')" />
  </ItemGroup>

</Project>
