<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Demo code; Endjin.Conventions.props is deliberately not imported. See Demo.Tracks for why. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UserSecretsId>dotnet-Ais.Net.Receiver.Demo.Visualizer-0b4d1f8e-2c73-4a51-9f66-7d2e4b8c1a03</UserSecretsId>

    <!-- Set to true to build without Node; the wwwroot bundle must then already be present. -->
    <SkipFrontendBuild Condition="'$(SkipFrontendBuild)' == ''">false</SkipFrontendBuild>
  </PropertyGroup>

  <!--
    No NATS client here on purpose: the browser subscribes to the receiver's messages itself, so this
    host only needs to tell the page where the broker is. It serves static files and two endpoints.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\Ais.Net.Receiver.ServiceDefaults\Ais.Net.Receiver.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Ais.Net.Receiver.Demo.Tracks\Ais.Net.Receiver.Demo.Tracks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      wwwroot is entirely generated by the Vite build below and is git-ignored, so it is included at
      build time rather than being listed as source-controlled Content.
    -->
    <Content Remove="wwwroot\**" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Vite bundles deck.gl and MapLibre from npm. Node is a build-time dependency only - nothing Node
    related runs at runtime, which is the point of serving this from ASP.NET Core rather than a Node
    dev server. Inputs/Outputs keep this a no-op once the bundle is current.
  -->
  <ItemGroup>
    <FrontendSource Include="$(MSBuildThisFileDirectory)ClientApp\**\*"
                    Exclude="$(MSBuildThisFileDirectory)ClientApp\node_modules\**" />
  </ItemGroup>

  <Target Name="BuildFrontend"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipFrontendBuild)' != 'true'"
          Inputs="@(FrontendSource)"
          Outputs="$(MSBuildThisFileDirectory)obj\frontend.stamp">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildThisFileDirectory)ClientApp"
          Condition="!Exists('$(MSBuildThisFileDirectory)ClientApp\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)ClientApp" />

    <Touch Files="$(MSBuildThisFileDirectory)obj\frontend.stamp" AlwaysCreate="true" />
  </Target>

</Project>
